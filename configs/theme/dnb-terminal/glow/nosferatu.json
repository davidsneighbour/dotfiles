{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#D2D0CB",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#9EA4AC",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#A6BAC0",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#C28FA3",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#9EA4AC"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#F2C861"
  },
  "strong": {
    "bold": true,
    "color": "#C9A273"
  },
  "hr": {
    "color": "#9EA4AC",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#A6BAC0"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#8CA3B5",
    "underline": true
  },
  "link_text": {
    "color": "#A6BAC0",
    "bold": true
  },
  "image": {
    "color": "#8CA3B5",
    "underline": true
  },
  "image_text": {
    "color": "#A6BAC0",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#9BAF84",
    "background_color": "#2E3236"
  },
  "code_block": {
    "color": "#D2D0CB",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#D2D0CB"
      },
      "error": {
        "color": "#D2D0CB",
        "background_color": "#FF7D6C"
      },
      "comment": {
        "color": "#9EA4AC"
      },
      "comment_preproc": {
        "color": "#C28FA3"
      },
      "keyword": {
        "color": "#C28FA3"
      },
      "keyword_reserved": {
        "color": "#C28FA3"
      },
      "keyword_namespace": {
        "color": "#C28FA3"
      },
      "keyword_type": {
        "color": "#A6BAC0",
        "italic": true
      },
      "operator": {
        "color": "#C28FA3"
      },
      "punctuation": {
        "color": "#D2D0CB"
      },
      "name": {
        "color": "#D2D0CB"
      },
      "name_builtin": {
        "color": "#A6BAC0",
        "italic": true
      },
      "name_tag": {
        "color": "#C28FA3"
      },
      "name_attribute": {
        "color": "#9BAF84"
      },
      "name_class": {
        "color": "#A6BAC0"
      },
      "name_constant": {
        "color": "#8CA3B5"
      },
      "name_decorator": {
        "color": "#9BAF84"
      },
      "name_function": {
        "color": "#9BAF84"
      },
      "literal_number": {
        "color": "#8CA3B5"
      },
      "literal_string": {
        "color": "#F2C861"
      },
      "literal_string_escape": {
        "color": "#C28FA3"
      },
      "generic_deleted": {
        "color": "#FF7D6C"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#9BAF84"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#9EA4AC"
      },
      "background": {
        "background_color": "#17191B"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "html_block": {},
  "html_span": {}
}
