#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.1
Type=Application
Name=ChatGPT
GenericName=AI Assistant
Icon=chatgpt
Exec=/home/patrick/.dotfiles/configs/session/i3/workspaces/workspaces.py launch --application chatgpt
Path=/home/patrick
StartupWMClass=chrome_chatgpt_app
Categories=Development;X-XFCE;X-Xfce-Toplevel;
