# i3 starter configuration
#
# See configs/session/i3/README.md for what this file is and is not, and
# SESSION.md (repo root) for the full session architecture. This is a
# deliberately small starter configuration: it must keep working (terminal,
# launcher, reload/restart/exit) even if Polybar, Rofi, or any exec_always
# command below fails.

################################################################################
# Variables
################################################################################

set $mod Mod4

# Single place to change the terminal. Do not hardcode the binary name
# anywhere else in this file.
set $terminal xfce4-terminal

# Plain numbered workspaces. No icons, no per-application assignment yet
# (see SESSION.md "Known limitations / next improvements").
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

################################################################################
# Appearance
################################################################################

font pango:sans-serif 10

# XFCE (xfwm4) has no explicit focus-follows-mouse override configured in
# this repo (configs/system/xfce/xfwm4.xml leaves click_to_focus unset,
# i.e. xfwm4's own default: click-to-focus). Mirror that here rather than
# introducing a new preference.
focus_follows_mouse no

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# i3 4.25 (installed on this host) always supports gaps; no i3-gaps needed.
gaps inner 6
gaps outer 0

################################################################################
# Session startup
#
# Every exec_always here MUST be non-fatal: a missing script or failing
# helper must never take down the rest of the session. Backgrounding (&)
# plus `|| true`/`|| :` on the i3 exec line keeps a bad exit status from
# doing anything i3 would notice.
################################################################################

# (Re)registers the GNOME Keyring's PKCS#11 and Secret Service
# (org.freedesktop.secrets) D-Bus components on this session's bus. PAM
# (pam_gnome_keyring.so `auto_start` in /etc/pam.d/lightdm) already starts
# and unlocks the daemon at login for every session, including this one, but
# that happens before the X session's D-Bus bus exists, so those two D-Bus
# services never get registered. XFCE papers over this with
# X-XFCE-Autostart-Override entries in configs/system/autostart/locutus/
# (gnome-keyring-pkcs11.desktop, gnome-keyring-secrets.desktop) that
# xfce4-session processes from ~/.config/autostart; i3 has no session
# manager reading that directory at all, so without this line apps that use
# libsecret (e.g. VS Code's credential storage) find no keyring under i3.
# gnome-keyring-daemon attaches to the already-running PAM instance (same
# control directory) instead of starting a second one, so this is safe to
# re-run on every restart.
exec_always --no-startup-id sh -c "/usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets || true"

# Guaranteed-visible root background so the desktop never looks "empty" even
# with no wallpaper image configured (see SESSION.md "Background").
exec_always --no-startup-id xsetroot -solid '#0B0D0F'

# Best-effort: overrides the solid colour with a real wallpaper image if one
# is ever added at config/theme/wallpaper.{jpg,png}. No-ops silently
# otherwise (see bashrc/helpers/theme/set-default-wallpaper.sh). Wrapped in
# `sh -c` with `|| true` so a non-zero exit never reaches i3.
exec_always --no-startup-id sh -c "$HOME/.dotfiles/bashrc/helpers/theme/set-default-wallpaper.sh || true"

# Polybar, restarted cleanly on every i3 restart. The launcher itself
# handles killing old instances, logging, and failing without touching i3;
# the `|| true` here is a second safety net at the i3 level.
exec_always --no-startup-id sh -c "$HOME/.dotfiles/configs/session/polybar/launch.sh || true"

################################################################################
# Launcher (Rofi)
#
# configs/session/i3/rofi.rasi is a small, standalone override (fuzzy
# matching, explicit width/centring) that reuses the existing shared theme
# from configs/system/rofi/theme.rasi rather than duplicating it — see that
# file's header comment and SESSION.md ("Rofi") for why.
set $rofi rofi -show drun -config "$HOME/.dotfiles/configs/session/i3/rofi.rasi"

# Primary: bare Super key. i3 cannot bind a bare modifier the normal way
# (bindsym only matches modifier+keysym, not a modifier alone), so this
# binds the Super_L keysym itself with --release: it fires only if Super_L
# is pressed and released without another key in between, so it does not
# interfere with the $mod+<key> bindings below. If this ever misfires or
# fails to trigger on a given keyboard/X11 setup, Super+D below is the
# documented, always-reliable fallback.
bindsym --release Super_L exec --no-startup-id $rofi

# Secondary: explicit, unconditionally reliable launcher binding.
bindsym $mod+d exec --no-startup-id $rofi

################################################################################
# Applications
################################################################################

bindsym $mod+Return exec $terminal

################################################################################
# Window management
################################################################################

bindsym $mod+Shift+q kill

bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

################################################################################
# Workspaces
################################################################################

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

################################################################################
# i3 session control
################################################################################

# Reload the configuration file without restarting i3 in-place.
bindsym $mod+Shift+c reload

# Restart i3 in place (preserves layout). exec_always commands above
# (Polybar, background) run again automatically; the Polybar launcher is
# responsible for not leaving duplicate bars behind.
bindsym $mod+Shift+r restart

# Exit i3, with a confirmation prompt so it cannot be triggered by accident.
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3? This ends the session.' -B 'Yes, exit i3' 'i3-msg exit'

################################################################################
# Resize mode (conventional i3 extra, kept small)
################################################################################

mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
