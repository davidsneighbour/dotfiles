################################################################################
# see https://i3wm.org/docs/userguide.html
################################################################################
# Variables

set $mod Mod4
set $terminal terminator

# Appearance
font pango:sans-serif 10
focus_follows_mouse no
default_border pixel 0
default_floating_border pixel 0
hide_edge_borders smart
gaps inner 0
gaps outer 0

# Includes
include configs/workspaces.conf
include configs/session-starts.conf
include configs/applications.conf
include configs/keybindings.conf
include configs/rules.conf

# <colorclass> <border> <background> <text> <indicator> <child_border>
client.focused          #6272A4 #6272A4 #F8F8F2 #6272A4   #6272A4
client.focused_inactive #44475A #44475A #F8F8F2 #44475A   #44475A
client.unfocused        #282A36 #282A36 #BFBFBF #282A36   #282A36
client.urgent           #44475A #FF5555 #F8F8F2 #FF5555   #FF5555
client.placeholder      #282A36 #282A36 #F8F8F2 #282A36   #282A36

client.background       #282A36


#bindsym $mod+d exec "dmenu_run -nf '#F8F8F2' -nb '#282A36' -sb '#6272A4' -sf '#F8F8F2' -fn 'monospace-10' -p 'dmenu%'"

# for_window [all] border normal

exec --no-startup-id xfsettingsd
