/**
 * i3 starter Rofi override.
 *
 * Small, standalone, functional config — deliberately not a fork of
 * configs/session/rofi/config.rasi (the base config the launcher falls
 * back to). It reuses that config's existing visual theme (@theme "theme"
 * resolves via rofi's own theme search path to ~/.config/rofi/theme.rasi,
 * which Dotbot links from configs/session/rofi/theme.rasi) so nothing is
 * visually duplicated, but sets the functional properties the i3 starter
 * spec calls for that the base config leaves at rofi's defaults (notably:
 * fuzzy matching is off by default in rofi; the base config never turned
 * it on).
 *
 * See configs/session/i3/README.md and SESSION.md ("Rofi") for why this
 * exists as a separate file instead of editing the base config.
 */

@theme "theme"

configuration {
    modi: "drun";
    matching: "fuzzy";
    case-sensitive: false;
    show-icons: true;
    width: 40;
    location: 0;
}
