
/*****----- Layout -----*****/
/* How the widgets are nested. The names are the selectors used in this
 * file (and in the shared theme.rasi). Search for a name to find its rule.
 *
 * +- window ------------------------------------------------------------+
 * |  500px wide, no padding, no border, no radius                       |
 * | +- mainbox -------------------------------------------------------+ |
 * | |  children: [ header, listview, message ], no spacing            | |
 * | | +- header (#header) ------------------------------------------+ | |
 * | | |  image from theme.rasi, 167px tall (top padding = 500 / 3)  | | |
 * | | +-------------------------------------------------------------+ | |
 * | | +- listview --------------------------------------------------+ | |
 * | | |  4 columns, 1 line, margin 28 28 20 28, spacing 28px        | | |
 * | | | +- element -+  +- element -+  +- element -+  +- element -+  | | |
 * | | | | 90 x 90px |  |           |  |           |  |           |  | | |
 * | | | | +-------+ |  | +-------+ |  | +-------+ |  | +-------+ |  | | |
 * | | | | |element| |  | |element| |  | |element| |  | |element| |  | | |
 * | | | | | -text | |  | | -text | |  | | -text | |  | | -text | |  | | |
 * | | | | +-------+ |  | +-------+ |  | +-------+ |  | +-------+ |  | | |
 * | | | +-----------+  +-----------+  +-----------+  +-----------+  | | |
 * | | +-------------------------------------------------------------+ | |
 * | | +- message ---------------------------------------------------+ | |
 * | | |  margin 0 15 15 15, padding 15px                            | | |
 * | | | +- textbox -----------------------------------------------+ | | |
 * | | | |  "Last Login: ... | Uptime: ..." (the -mesg text)       | | | |
 * | | | +---------------------------------------------------------+ | | |
 * | | +-------------------------------------------------------------+ | |
 * | +-----------------------------------------------------------------+ |
 * +---------------------------------------------------------------------+
 *
 * element states: `element normal.normal`, `element alternate.normal`
 * (unselected) and `element selected.normal` (highlighted button).
 *
 * The confirmation dialogue (confirm_cmd in powermenu.sh) uses the same
 * widgets, but overrides them with -theme-str: window 350px, header
 * 117px, children [ header, message, listview ], 2 columns.
 */

/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*
 * Import first so this file's own window/mainbox/header rules below can
 * override the shared theme's generic ones — rofi's cascade is last-wins,
 * so importing after those rules were defined used to let the shared
 * #window/#mainbox silently replace this menu's own size, radius, and
 * children list. Colours and the header image still come from the shared
 * theme.rasi; only the names below are local aliases onto its palette so
 * the rest of this file can keep using its own semantic names.
 */
@import "theme"
@theme "theme"

* {
    background:     @dnb-background;
    background-alt: @dnb-current;
    foreground:     @dnb-foreground;
    selected:       @active-background;
}

/*****----- Main Window -----*****/
window {
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    0px;

    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    cursor:                      "default";
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "header", "listview", "message" ];
}

/* Reuses the shared theme's #header (image) rule. The system has no
 * compositor transparency, so the outer corners have no radius. The
 * height must match this window's own width so the full 3:1 image
 * shows: width 500px, border 0px -> 500 / 3 = 167px. */
#header {
    border-radius:                0px;
    padding:                      167px 0px 0px 0px;
}

/*****----- Listview -----*****/
/*
 * rofi has no flexbox. The nearest match is the listview grid: it splits
 * its inner width into `columns` equal cells, with `spacing` between them.
 * To get `justify-content: space-evenly`, the horizontal margin is the
 * same as the spacing, and both are calculated so that each cell is
 * exactly one circle wide:
 *   cell = (width - 2 * margin - (columns - 1) * spacing) / columns
 *        = (500 - 2 * 28 - 3 * 28) / 4 = 90px
 * Change these values together with the element size below. The
 * confirmation dialogue in powermenu.sh does the same for its 2 columns.
 */
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     28px;
    margin:                      28px 28px 20px 28px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
/*
 * Each element is a 90px circle with the icon in its centre. The width
 * comes from the listview cell above. rofi has no `height` or
 * `aspect-ratio` for a box, so the height comes from the icon line
 * (27px for "lucide 24" at the `dpi: 72` in config.rasi) plus the
 * vertical padding: 28px + 27px + 35px = 90px. The padding is not
 * symmetric because the glyphs sit 3px low in their line box; this
 * moves them to the true centre of the circle. If the font, its size,
 * or the dpi change, measure the line height again and change the
 * padding. The radius is half the diameter (a `%` radius is taken from
 * the monitor size, not from the element).
 */
element {
    enabled:                     true;
    orientation:                 horizontal;
    children:                    [ "element-text" ];
    padding:                     28px 0px 35px 0px;
    border-radius:               45px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    font:                        "lucide 24";
    //font:                        "feather bold 32";
    expand:                      true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
/*
 * The shared theme sets a transparent background for the normal and
 * alternate states. These rules come after the import, so they win and
 * every button shows as a filled circle, not only the selected one.
 */
element normal.normal,
element alternate.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            var(selected);
    text-color:                  var(background);
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px 15px 15px 15px;
    padding:                     15px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @foreground;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
