
/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*
 * Import first so this file's own window/mainbox/header rules below can
 * override the shared theme's generic ones — rofi's cascade is last-wins,
 * so importing after those rules were defined used to let the shared
 * #window/#mainbox silently replace this menu's own size, radius, and
 * children list. Colours and the header image still come from the shared
 * theme.rasi; only the names below are local aliases onto its palette so
 * the rest of this file can keep using its own semantic names.
 */
@import "theme"
@theme "theme"

* {
    background:     @dnb-background;
    background-alt: @dnb-current;
    foreground:     @dnb-foreground;
    selected:       @active-background;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    0px;

    padding:                     0px;
    border:                      0px solid;
    border-radius:               20px;
    border-color:                @selected;
    cursor:                      "default";
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "header", "listview", "message" ];
}

/* Reuses the shared theme's #header (image) rule; only the corner radius
 * needs to match this window's own 20px instead of the shared 16px. */
#header {
    border-radius:                20px 20px 0px 0px;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     15px;
    margin:                      15px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     28px 10px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    font: "lucide 24";
    //font:                        "feather bold 32";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
element selected.normal {
    background-color:            var(selected);
    text-color:                  var(background);
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px 15px 15px 15px;
    padding:                     15px;
    border-radius:               100%;
    background-color:            @background-alt;
    text-color:                  @foreground;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
