/**
 * documentation: https://davatorium.github.io/rofi/2.0.0/rofi-theme.5/
 */

// ┌────────────────────────────────────────────────────────────────────────────────────┐
// │ window {BOX:vertical}                                                              │
// │ ┌────────────────────────────────────────────────────────────────────────────────┐ │
// │ │ mainbox  {BOX:vertical}                                                        │ │
// │ │ ┌────────────────────────────────────────────────────────────────────────────┐ │ │
// │ │ │ inputbar {BOX:horizontal}                                                  │ │ │
// │ │ │ ┌─────────┐ ┌─┐ ┌────────────────────────────────┐ ┌───┐ ┌───┐ ┌───┐ ┌───┐ │ │ │
// │ │ │ │ prompt  │ │:│ │ entry                          │ │#fr│ │ / │ │#ns│ │ci │ │ │ │
// │ │ │ └─────────┘ └─┘ └────────────────────────────────┘ └───┘ └───┘ └───┘ └───┘ │ │ │
// │ │ └────────────────────────────────────────────────────────────────────────────┘ │ │
// │ │ ┌────────────────────────────────────────────────────────────────────────────┐ │ │
// │ │ │ message                                                                    │ │ │
// │ │ │ ┌────────────────────────────────────────────────────────────────────────┐ │ │ │
// │ │ │ │ textbox                                                                │ │ │ │
// │ │ │ └────────────────────────────────────────────────────────────────────────┘ │ │ │
// │ │ └────────────────────────────────────────────────────────────────────────────┘ │ │
// │ │ ┌────────────────────────────────────────────────────────────────────────────┐ │ │
// │ │ │ listview                                                                   │ │ │
// │ │ │ ┌────────────────────────────────────────────────────────────────────────┐ │ │ │
// │ │ │ │ element                                                                │ │ │ │
// │ │ │ │ ┌─────────────────┐ ┌────────────────────────────────────────────────┐ │ │ │ │
// │ │ │ │ │ element─icon    │ │ element─text                                   │ │ │ │ │
// │ │ │ │ └─────────────────┘ └────────────────────────────────────────────────┘ │ │ │ │
// │ │ │ └────────────────────────────────────────────────────────────────────────┘ │ │ │
// │ │ └────────────────────────────────────────────────────────────────────────────┘ │ │
// │ │ ┌────────────────────────────────────────────────────────────────────────────┐ │ │
// │ │ │  mode─switcher {BOX:horizontal}                                            │ │ │
// │ │ │ ┌───────────────┐┌───────────────┐┌──────────────┐┌──────────────────────┐ │ │ │
// │ │ │ │ Button        ││ Button        ││ Button       ││ Button               │ │ │ │
// │ │ │ └───────────────┘└───────────────┘└──────────────┘└──────────────────────┘ │ │ │
// │ │ └────────────────────────────────────────────────────────────────────────────┘ │ │
// │ └────────────────────────────────────────────────────────────────────────────────┘ │
// └────────────────────────────────────────────────────────────────────────────────────┘

// ┌──────────────────────────────────────────────────────────────────────────────────┐
// │ window {BOX:vertical}                                                            │
// │ ┌─────────────────────────────────────────────────────────────────────────────┐  │
// │ │ error─message {BOX:vertical}                                                │  │
// │ │ ┌────────────────────────────────────────────────────────────────────────┐  │  │
// │ │ │ textbox                                                                │  │  │
// │ │ └────────────────────────────────────────────────────────────────────────┘  │  │
// │ └─────────────────────────────────────────────────────────────────────────────┘  │
// └──────────────────────────────────────────────────────────────────────────────────┘

configuration {
    show-icons: true;
    display-drun: "select program to start";
    disable-history: false;
}

* {

    dnb-background: #0B0D0F;
    dnb-background2: #0B0D0Fcc;
    dnb-current: #414D58;
    dnb-foreground: #F8F8F2;
    dnb-comment: #708CA9;
    dnb-cyan: #80FFEA;
    dnb-green: #8AFF80;
    dnb-orange: #FFCA80;
    dnb-pink: #FF80BF;
    dnb-purple: #9580FF;
    dnb-red: #FF9580;
    dnb-yellow: #FFFF80;

    /* Recursive Sans Linear Light via variable-font axes: `fc-list | grep 'Recursive'` */
    font: "Recursive 11 wght=300,CASL=0,MONO=0,CRSV=0.5";

    foreground: @dnb-foreground;
    background-color: transparent;
    active-background: @dnb-orange;
    urgent-background: @dnb-pink;
    urgent-foreground: @dnb-background;

    selected-background: @active-background;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    selected-foreground: @dnb-background2;
    separatorcolor: @active-background;
    bordercolor: @dnb-comment;
}

#window {
    background-color: @dnb-background2;
    border: 1;
    border-color: @bordercolor;
    /* padding and border-radius: see "Shared structure" below */
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 0px;
    border-color: @separatorcolor;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#listview {
    fixed-height: 0;
    border: 0px;
    border-color: @bordercolor;
    spacing: 2px;
    scrollbar: false;
    padding: 2px 0px 0px;
}

#element {
    border: 0;
    padding: 3px;
}

#element.normal.normal {
    background-color: @background-color;
    text-color: @foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @dnb-background2;
}

#element.selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @dnb-background2;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @dnb-background2;
}

#element.alternate.normal {
    background-color: @background-color;
    text-color: @foreground;
}

#element.alternate.urgent {
    background-color: @urgent-background;
    text-color: @dnb-background2;
}

#element.alternate.active {
    background-color: @active-background;
    text-color: @foreground;
}

#scrollbar {
    width: 2px;
    border: 0;
    handle-width: 8px;
    padding: 0;
}

#sidebar {
    border: 2px dash 0px 0px;
    border-color: @separatorcolor;
}

#button.selected {
    background-color: @selected-background;
    text-color: @dnb-background2;
}

#inputbar {
    spacing: 0;
    text-color: @dnb-background2;
    padding: 1px;
    children: [ prompt, textbox-prompt-colon, entry, case-indicator];
}

#case-indicator {
    spacing: 0;
    text-color: @dnb-background2;
}

#entry {
    spacing: 0;
    text-color: @dnb-cyan;
}

#prompt {
    spacing: 0;
    text-color: @dnb-green;
}

#textbox-prompt-colon {
    expand: false;
    str: ">";
    margin: 0px 0.3em 0em 0em;
    text-color: @dnb-red;
}

element-text,
element-icon {
    background-color: inherit;
    text-color: inherit;
}

element-text {
    /* Monospaced list labels keep Rofi rows visually stable across mixed names. */
    font: "Monaspace Argon 11";
}

/*****----- Shared structure (radius + header image) -----*****/
/*
 * Same box layout as configs/session/rofi/power/powermenu.rasi (rounded
 * corners, an image above the input row) but built on this file's own
 * palette above — powermenu.rasi keeps its own separate colours on
 * purpose and is not meant to match this theme.
 *
 * The window itself now carries no padding, so its only child (mainbox)
 * — and the header image inside it — can reach the window's rounded
 * border edge-to-edge. Every other direct child of mainbox (inputbar,
 * message, listview, mode-switcher) gets its own left/right/bottom
 * margin instead, to keep the same 15px inset those rows had before.
 */
#window {
    padding: 0px;
    border-radius: 16px;
}

#mainbox {
    children: [ "header", "inputbar", "message", "listview", "mode-switcher" ];
}

#header {
    expand: false;
    background-color: transparent;
    background-image: url("~/.dotfiles/configs/session/i3/header-1800x900.jpg", width);
    border-radius: 16px 16px 0px 0px;
    padding: 50px 0px 0px 0px;
}

#inputbar {
    margin: 0px 15px 0px 15px;
}

#message {
    margin: 0px 15px 15px 15px;
}

#listview {
    margin: 0px 15px 15px 15px;
}

#mode-switcher {
    margin: 0px 15px 15px 15px;
}
