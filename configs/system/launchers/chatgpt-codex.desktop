#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Terminal=false
Type=Application
Name=Codex
Exec=/opt/google/chrome/google-chrome --user-data-dir="$HOME/.local/share/chrome-apps/chatgpt-chrome" --app=https://chatgpt.com/codex/cloud
Icon=chatgpt
StartupWMClass=chrome_chatgpt_codex
Categories=Development;X-XFCE;X-Xfce-Toplevel;
