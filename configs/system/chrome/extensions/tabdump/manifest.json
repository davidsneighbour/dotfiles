{
  "manifest_version": 3,
  "name": "Tabdump",
  "version": "1.1.0",
  "description": "Copy all URLs from the active Chrome tab group to the clipboard.",
  "permissions": [
    "tabs",
    "clipboardWrite",
    "offscreen"
  ],
  "action": {
    "default_title": "Copy URLs from this tab group",
    "default_icon": {
      "16": "icons/copy-16.png",
      "32": "icons/copy-32.png",
      "48": "icons/copy-48.png",
      "128": "icons/copy-128.png"
    }
  },
  "icons": {
    "16": "icons/copy-16.png",
    "32": "icons/copy-32.png",
    "48": "icons/copy-48.png",
    "128": "icons/copy-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
