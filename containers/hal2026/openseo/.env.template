# Copy to .env and set real values before the first start.
COMPOSE_PROJECT_NAME=openseo
# S3 storage credentials. Choose them before the first start; a restore needs
# the same values. Generate the secret with: openssl rand -hex 32
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=################################################################
# local_noauth: no sign-in, one admin user. Anyone who can reach port 3010 can
# use the app and spend DataForSEO credit.
# password: email and password accounts. Needs an HTTPS BETTER_AUTH_URL.
AUTH_MODE=local_noauth
# Must be HTTPS or a loopback address. Keep localhost for plain HTTP on the LAN.
BETTER_AUTH_URL=http://localhost:3010
# Base64-encoded login:password from DataForSEO.
DATAFORSEO_API_KEY=
# Optional feature credentials.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
CONTEXT_API_KEY=
CRAWLER_ACCESS_SECRET=
