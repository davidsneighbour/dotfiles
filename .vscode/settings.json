{
  "[jsonnet]": {
    "editor.defaultFormatter": "Grafana.vscode-jsonnet"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "chat.tools.terminal.autoApprove": {
    "mkdir": true
  },
  "cSpell.customDictionaries": {
    "dotfiles": {
      "addWords": true,
      "description": "Words used in this project",
      "name": "dotfiles",
      "path": "${workspaceFolder:dotfiles}/.vscode/dictionary.txt",
      "scope": "workspace"
    }
  },
  "cSpell.enabled": true,
  "cSpell.language": "en-GB",
  "cSpell.validateDirectives": true,
  "deno.enable": false,
  "editor.allowVariableFontsInAccessibilityMode": false,
  "editor.codeLensFontFamily": "'Monaspace Argon ExtraLight'",
  "editor.defaultFormatter": "biomejs.biome",
  "editor.fontFamily": "Monaspace Argon ExtraLight, Fira Code, Monaco, monospace",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'liga'",
  "editor.fontSize": 12,
  "editor.fontVariations": "'wght' 250",
  "editor.inlayHints.fontFamily": "'Monaspace Argon ExtraLight'",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "storage,entity,variable",
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  "evenBetterToml.formatter.trailingNewline": true,
  //"peacock.color": "#6272a4",
  "explorer.fileNesting.patterns": {
    ".agents": ".claude, .codex"
  },
  "files.insertFinalNewline": true,
  "markdown.extension.toc.levels": "2..6",
  "terminal.integrated.fontFamily": "Monaspace Argon ExtraLight, Fira Code, Monaco, monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "'calt' on, 'liga' on, 'ss01' on, 'ss02' on, 'ss03' on, 'ss04' on, 'ss05' on, 'ss06' on, 'ss07' on, 'ss08' on, 'ss09' on, 'ss10' on",
  "terminal.integrated.fontWeight": 150,
  "terminal.integrated.fontWeightBold": 500,
  // https://code.visualstudio.com/api/references/theme-color
  "workbench.colorCustomizations": {
    "editorIndentGuide.activeBackground1": "#ff9900",
    "editorIndentGuide.background1": "#00000001",
    "activityBar.activeBackground": "#a60052",
    "activityBar.background": "#a60052",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#102000",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#a60052",
    "statusBar.background": "#730039",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#a60052",
    "statusBarItem.remoteBackground": "#3f8000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#730039",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#73003999",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#a60052",
    "activityBarTop.background": "#a60052",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "statusBar.debuggingBackground": "#730039",
    "statusBar.debuggingForeground": "#e7e7e7"
  },
  "yaml.validate": true,
  "markdownlint.configFile": "node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc",
  "peacock.color": "#730039"
}
