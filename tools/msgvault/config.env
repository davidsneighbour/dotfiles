# shellcheck shell=bash

# msgvault helper defaults.
# shellcheck disable=SC2034
DNB_MSGVAULT_CONFIG_BACKUP_DIR="/mnt/storage/Backup/msgvault"

# Retired accounts that stay in the archive but have no OAuth token any more.
# sync.sh drops msgvault's "Skipping <account> (no OAuth token ...)" line for
# these accounts, so the logs only show real problems. Separate with spaces.
# shellcheck disable=SC2034
DNB_MSGVAULT_IGNORED_ACCOUNTS="patrick@davids-neighbour.com"
