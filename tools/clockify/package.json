{
  "name": "@davidsneighbour/clockify",
  "version": "0.1.0",
  "private": true,
  "description": "Small Clockify CLI and local form for workstation time tracking.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dnb-clockify": "src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project web/tsconfig.json --noEmit",
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  }
}
