filters:
  and:
    - file.inFolder("23 Eventlog/Github/repositories")
    - 'type == "git-repository"'
formulas:
  repository: 'file.asLink(title)'
  observation: 'link("23 Eventlog/Github/observations/" + repository_id, "Observation")'
  last_success: 'if(formula.observation.asFile(), formula.observation.asFile().properties.last_success)'
  complete: 'if(formula.observation.asFile(), formula.observation.asFile().properties.complete, false)'
properties:
  formula.repository:
    displayName: Repository
  formula.last_success:
    displayName: Last verified scan
  formula.complete:
    displayName: Last attempt complete
  formula.observation:
    displayName: Freshness details
views:
  - type: table
    name: All
    order:
      - formula.repository
      - slug
      - labels
      - retired
      - formula.last_success
      - formula.complete
      - formula.observation
  - type: table
    name: Uncertain
    filters: 'formula.complete != true'
    order:
      - formula.repository
      - formula.last_success
      - formula.observation
