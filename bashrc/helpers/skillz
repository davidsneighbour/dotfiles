#!/usr/bin/env bash

set -Eeuo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

SKILL_REPOSITORIES=(
  "/home/patrick/github.com/davidsneighbour/ai"
  "/home/patrick/github.com/davidsneighbour/clerkwork"
  "/home/patrick/github.com/davidsneighbour/gallimaufry"
  "/home/patrick/github.com/davidsneighbour/gazetteer"
  "/home/patrick/github.com/davidsneighbour/idiolect"
  "/home/patrick/github.com/davidsneighbour/patternbook"
  "/home/patrick/github.com/davidsneighbour/posthaste"
  "/home/patrick/github.com/davidsneighbour/skills"
)

# Every skill gets one symlink under each of these roots.
AGENT_SKILL_ROOTS=(
  "~/.agents/skills"
  "~/.codex/skills"
  "~/.claude/skills"
)

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "${SCRIPT_PATH}")/../.." && pwd)"
DOTBOT_CONFIG="${REPO_ROOT}/configs/dotbot/config.ai-skills.yaml"

declare -A SKILL_PATHS=()
TRUSTED_ROOTS=()

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Parent directory of every SKILL_REPOSITORIES entry, deduplicated. Only
# symlinks resolving under one of these roots are ever touched automatically;
# anything else found in an agent skill directory is left alone.
compute_trusted_roots() {
  local repository parent seen existing

  for repository in "${SKILL_REPOSITORIES[@]}"; do
    parent="$(dirname "${repository}")"

    seen=0
    for existing in "${TRUSTED_ROOTS[@]:-}"; do
      [[ "${existing}" == "${parent}" ]] && seen=1 && break
    done
    ((seen)) || TRUSTED_ROOTS+=("${parent}")
  done
}

# Find every single skill directory (skills/<name>) across all repositories
# and record it in SKILL_PATHS[name]=path. Repositories without a skills/
# directory are skipped. Hidden directories (like a repo-local .system) are
# not skills and are skipped too.
collect_skills() {
  local repository skills_dir entry name path

  for repository in "${SKILL_REPOSITORIES[@]}"; do
    [[ -d "${repository}" ]] || die "Repository does not exist: ${repository}"

    skills_dir="${repository}/skills"
    [[ -d "${skills_dir}" ]] || continue

    for entry in "${skills_dir}"/*/; do
      [[ -d "${entry}" ]] || continue

      path="${entry%/}"
      name="$(basename "${path}")"

      if [[ -n "${SKILL_PATHS[${name}]:-}" ]]; then
        die "Duplicate skill name '${name}' found in:
  ${SKILL_PATHS[${name}]}
  ${path}"
      fi

      SKILL_PATHS["${name}"]="${path}"
    done
  done
}

# Print a skill's absolute path with $HOME collapsed to ${HOME}, so the
# generated config stays portable across machines that share this dotfiles repo.
portable_path() {
  local path="$1"

  printf '%s' "${path/#${HOME}/\$\{HOME\}}"
}

write_dotbot_config() {
  local root name trusted trusted_pattern

  trusted_pattern=""
  for trusted in "${TRUSTED_ROOTS[@]}"; do
    trusted_pattern+="\"$(portable_path "${trusted}")\"/*|"
  done
  trusted_pattern="${trusted_pattern%|}"

  {
    printf -- '---\n'
    printf '################################################################################\n'
    printf '# Setup configuration for Dotbot\n'
    printf '#\n'
    printf '# @see https://github.com/anishathalye/dotbot for more info\n'
    printf '################################################################################\n'
    printf '# AI skill symlinks: every skill directory found under skills/ in each\n'
    printf '# SKILL_REPOSITORIES entry (see bashrc/helpers/skillz), linked into every\n'
    printf '# agent skill root.\n'
    printf '#\n'
    printf '# This file is generated by `skillz`. Do not edit it by hand; edit\n'
    printf '# SKILL_REPOSITORIES in bashrc/helpers/skillz and re-run `skillz` instead.\n'
    printf '\n'
    printf -- '- defaults:\n'
    printf '    link:\n'
    printf '      create: true\n'
    printf '      relink: true\n'
    printf '      force: true\n'
    printf '\n'
    printf -- '- shell:\n'
    printf '    -\n'
    printf '      description: Ensure agent skill roots are real directories, touching only symlinks that resolve into a known skill repository\n'
    printf '      command: |\n'
    printf '        set -e\n'
    printf '        shopt -s nullglob\n'
    printf '\n'
    printf '        is_trusted() {\n'
    printf '          case "$1" in\n'
    printf '            %s) return 0 ;;\n' "${trusted_pattern}"
    printf '            *) return 1 ;;\n'
    printf '          esac\n'
    printf '        }\n'
    printf '\n'
    printf '        for dir in %s; do\n' "${AGENT_SKILL_ROOTS[*]}"
    printf '          expanded="${dir/#\\~/$HOME}"\n'
    printf '\n'
    printf '          if [ -L "${expanded}" ]; then\n'
    printf '            resolved="$(readlink -f "${expanded}" 2>/dev/null || true)"\n'
    printf '            if is_trusted "${resolved}"; then\n'
    printf '              rm "${expanded}"\n'
    printf '            else\n'
    printf '              echo "skillz: refusing to touch ${expanded} -> ${resolved} (outside known skill repositories)" >&2\n'
    printf '              exit 1\n'
    printf '            fi\n'
    printf '          fi\n'
    printf '\n'
    printf '          mkdir -p "${expanded}"\n'
    printf '\n'
    printf '          for entry in "${expanded}"/*; do\n'
    printf '            [ -L "${entry}" ] || continue\n'
    printf '            [ -e "${entry}" ] && continue\n'
    printf '            resolved="$(readlink -f "${entry}" 2>/dev/null || true)"\n'
    printf '            is_trusted "${resolved}" && rm "${entry}"\n'
    printf '          done\n'
    printf '        done\n'
    printf '\n'
    printf -- '- link:\n'
    for name in $(printf '%s\n' "${!SKILL_PATHS[@]}" | sort); do
      for root in "${AGENT_SKILL_ROOTS[@]}"; do
        printf '    %s/%s:\n' "${root}" "${name}"
        printf '      path: %s\n' "$(portable_path "${SKILL_PATHS[${name}]}")"
      done
    done
  } >"${DOTBOT_CONFIG}"
}

show_symlinks() {
  local directory

  printf '\nInstalled symlinks:\n\n'

  for directory in \
    "${HOME}/.agents/skills" \
    "${HOME}/.codex/skills" \
    "${HOME}/.claude/skills"; do
    [[ -d "${directory}" ]] || continue

    printf '%s\n' "${directory}"

    find "${directory}" \
      -mindepth 1 \
      -maxdepth 1 \
      -type l \
      -printf '  %f -> %l\n' \
      2>/dev/null || true
  done
}

main() {
  command -v dotfiles >/dev/null 2>&1 || die "dotfiles is not available in PATH."

  compute_trusted_roots

  printf 'Collecting skills from SKILL_REPOSITORIES...\n'
  collect_skills

  ((${#SKILL_PATHS[@]} > 0)) || die "No skills found under any SKILL_REPOSITORIES entry."

  printf 'Found %d skill(s).\n' "${#SKILL_PATHS[@]}"
  printf 'Regenerating %s...\n' "${DOTBOT_CONFIG}"
  write_dotbot_config

  printf '\nRunning: dotfiles ai-skills\n\n'
  dotfiles ai-skills

  show_symlinks

  printf '\nDone.\n'
}

main "$@"
