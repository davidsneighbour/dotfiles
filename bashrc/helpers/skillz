#!/bin/bash

set -Eeuo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# All skills live in skillwerk, grouped into collections:
# ${SKILLWERK_ROOT}/collections/<collection>/skills/<skill>
SKILLWERK_ROOT="${HOME}/github.com/davidsneighbour/skillwerk"

# Symlinks resolving under one of these roots are managed by skillz. The
# parent of skillwerk is included so links into the former per-repository
# skill locations are cleaned up as well.
TRUSTED_ROOTS=(
  "$(dirname "${SKILLWERK_ROOT}")"
)

# Every skill gets one symlink under each of these roots.
AGENT_SKILL_ROOTS=(
  "~/.agents/skills"
  "~/.codex/skills"
  "~/.claude/skills"
)

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "${SCRIPT_PATH}")/../.." && pwd)"
DOTBOT_CACHE_DIR="${REPO_ROOT}/cache/dotbot"
DOTBOT_CONFIG="${DOTBOT_CACHE_DIR}/config.ai-skills.yaml"

declare -A SKILL_PATHS=()

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Find every single skill directory (collections/*/skills/<name>) in
# skillwerk and record it in SKILL_PATHS[name]=path. Collections without a
# skills/ directory are skipped. Hidden directories (like a local .system) are
# not skills and are skipped too.
collect_skills() {
  local skills_dir entry name path

  [[ -d "${SKILLWERK_ROOT}/collections" ]] ||
    die "Skill collections do not exist: ${SKILLWERK_ROOT}/collections"

  for skills_dir in "${SKILLWERK_ROOT}"/collections/*/skills; do
    [[ -d "${skills_dir}" ]] || continue

    for entry in "${skills_dir}"/*/; do
      [[ -d "${entry}" ]] || continue

      path="${entry%/}"
      name="$(basename "${path}")"

      if [[ -n "${SKILL_PATHS[${name}]:-}" ]]; then
        die "Duplicate skill name '${name}' found in:
  ${SKILL_PATHS[${name}]}
  ${path}"
      fi

      SKILL_PATHS["${name}"]="${path}"
    done
  done
}

# Print a skill's absolute path with $HOME collapsed to ${HOME}, so the
# generated config stays portable across machines that share this dotfiles repo.
portable_path() {
  local path="$1"

  printf '%s' "${path/#${HOME}/\$\{HOME\}}"
}

write_dotbot_config() {
  local root name trusted trusted_pattern

  mkdir -p "${DOTBOT_CACHE_DIR}"

  trusted_pattern=""
  for trusted in "${TRUSTED_ROOTS[@]}"; do
    trusted_pattern+="\"$(portable_path "${trusted}")\"/*|"
  done
  trusted_pattern="${trusted_pattern%|}"

  {
    printf -- '---\n'
    printf '################################################################################\n'
    printf '# Setup configuration for Dotbot\n'
    printf '#\n'
    printf '# @see https://github.com/anishathalye/dotbot for more info\n'
    printf '################################################################################\n'
    printf '# AI skill symlinks: every skill directory found under\n'
    printf '# skillwerk/collections/*/skills (see bashrc/helpers/skillz), linked into\n'
    printf '# every agent skill root.\n'
    printf '#\n'
    printf '# This file is generated by `skillz`. Do not edit it by hand; edit\n'
    printf '# bashrc/helpers/skillz and re-run `skillz` instead.\n'
    printf '\n'
    printf -- '- defaults:\n'
    printf '    link:\n'
    printf '      create: true\n'
    printf '      relink: true\n'
    printf '      force: true\n'
    printf '\n'
    printf -- '- shell:\n'
    printf '    -\n'
    printf '      description: Ensure agent skill roots are real directories and remove managed skill symlinks (only those that resolve into a known skill location) before relinking\n'
    printf '      command: |\n'
    printf '        set -e\n'
    printf '        shopt -s nullglob\n'
    printf '\n'
    printf '        is_trusted() {\n'
    printf '          case "$1" in\n'
    printf '            %s) return 0 ;;\n' "${trusted_pattern}"
    printf '            *) return 1 ;;\n'
    printf '          esac\n'
    printf '        }\n'
    printf '\n'
    printf '        for dir in %s; do\n' "${AGENT_SKILL_ROOTS[*]}"
    printf '          expanded="${dir/#\\~/$HOME}"\n'
    printf '\n'
    printf '          if [ -L "${expanded}" ]; then\n'
    printf '            resolved="$(readlink -f "${expanded}" 2>/dev/null || true)"\n'
    printf '            if is_trusted "${resolved}"; then\n'
    printf '              rm "${expanded}"\n'
    printf '            else\n'
    printf '              echo "skillz: refusing to touch ${expanded} -> ${resolved} (outside known skill repositories)" >&2\n'
    printf '              exit 1\n'
    printf '            fi\n'
    printf '          fi\n'
    printf '\n'
    printf '          mkdir -p "${expanded}"\n'
    printf '\n'
    printf '          for entry in "${expanded}"/*; do\n'
    printf '            [ -L "${entry}" ] || continue\n'
    printf '            resolved="$(readlink -f "${entry}" 2>/dev/null || true)"\n'
    printf '            is_trusted "${resolved}" && rm "${entry}"\n'
    printf '          done\n'
    printf '        done\n'
    printf '\n'
    printf -- '- link:\n'
    for name in $(printf '%s\n' "${!SKILL_PATHS[@]}" | sort); do
      for root in "${AGENT_SKILL_ROOTS[@]}"; do
        printf '    %s/%s:\n' "${root}" "${name}"
        printf '      path: %s\n' "$(portable_path "${SKILL_PATHS[${name}]}")"
      done
    done
  } >"${DOTBOT_CONFIG}"
}

show_symlinks() {
  local directory

  printf '\nInstalled symlinks:\n\n'

  for directory in \
    "${HOME}/.agents/skills" \
    "${HOME}/.codex/skills" \
    "${HOME}/.claude/skills"; do
    [[ -d "${directory}" ]] || continue

    printf '%s\n' "${directory}"

    find "${directory}" \
      -mindepth 1 \
      -maxdepth 1 \
      -type l \
      -printf '  %f -> %l\n' \
      2>/dev/null || true
  done
}

main() {
  command -v dotfiles >/dev/null 2>&1 || die "dotfiles is not available in PATH."

  printf 'Collecting skills from %s/collections...\n' "${SKILLWERK_ROOT}"
  collect_skills

  ((${#SKILL_PATHS[@]} > 0)) || die "No skills found under ${SKILLWERK_ROOT}/collections/*/skills."

  printf 'Found %d skill(s).\n' "${#SKILL_PATHS[@]}"
  printf 'Regenerating %s...\n' "${DOTBOT_CONFIG}"
  write_dotbot_config

  printf '\nRunning: dotfiles %s\n\n' "${DOTBOT_CONFIG}"
  dotfiles "${DOTBOT_CONFIG}"

  show_symlinks

  printf '\nDone.\n'
}

main "$@"
