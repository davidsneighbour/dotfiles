#!/bin/bash

set -Eeuo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Skill sources as "<type>:<root>". Supported types:
#
#   collections  skillwerk layout: <root>/collections/<collection>/skills/<skill>
#   tree         free-form tree: every deepest directory below <root> that
#                contains a SKILL.md, up to three folder levels deep:
#                  <root>/<skill>/SKILL.md
#                  <root>/<collection>/<skill>/SKILL.md
#                  <root>/<topic>/<collection>/<skill>/SKILL.md
#
# Skills are named after their directory and linked flat into every agent
# skill root, so names must be unique across all sources. A skill found twice
# under the same real path (for example through a symlinked collection) is
# linked once.
SKILLWERK_ROOT="${HOME}/github.com/davidsneighbour/skillwerk"
SKILL_SOURCES=(
  "collections:${SKILLWERK_ROOT}"
  "tree:${HOME}/github.com/davidsneighbour/skills/skills"
)

# Symlinks resolving under one of these roots are managed by skillz. The
# parent of skillwerk is included so links into the other skill repositories
# (and the former per-repository skill locations) are cleaned up as well.
TRUSTED_ROOTS=(
  "$(dirname "${SKILLWERK_ROOT}")"
)

# Every skill gets one symlink under each of these roots.
AGENT_SKILL_ROOTS=(
  "~/.agents/skills"
  "~/.codex/skills"
  "~/.claude/skills"
)

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "${SCRIPT_PATH}")/../.." && pwd)"
DOTBOT_CACHE_DIR="${REPO_ROOT}/cache/dotbot"
DOTBOT_CONFIG="${DOTBOT_CACHE_DIR}/config.ai-skills.yaml"

VERBOSE=false

declare -A SKILL_PATHS=()

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: $(basename "${SCRIPT_PATH}") [--verbose] [--help]

Collect skills from every source in SKILL_SOURCES, regenerate
${DOTBOT_CONFIG}, and link all skills into:
  ${AGENT_SKILL_ROOTS[*]}

Options:
  --verbose  Print every skill found and every directory skipped.
  --help     Show this help.
EOF
}

log_verbose() {
  [[ "${VERBOSE}" == true ]] || return 0
  printf '  %s\n' "$*"
}

# Record one skill directory in SKILL_PATHS[name]=path. A second hit with the
# same real path is skipped; a different directory with the same name is fatal.
add_skill() {
  local path="$1"
  local name existing

  name="$(basename "${path}")"
  existing="${SKILL_PATHS[${name}]:-}"

  if [[ -n "${existing}" ]]; then
    if [[ "$(readlink -f "${existing}")" == "$(readlink -f "${path}")" ]]; then
      log_verbose "skip ${path} (same skill as ${existing})"
      return 0
    fi

    die "Duplicate skill name '${name}' found in:
  ${existing}
  ${path}"
  fi

  log_verbose "${name} -> ${path}"
  SKILL_PATHS["${name}"]="${path}"
}

# Type "collections": every collections/*/skills/<name> directory that contains
# a SKILL.md. Collections without a skills/ directory are skipped. Hidden
# directories (like a local .system) are not matched by the glob.
collect_collections() {
  local root="$1"
  local skills_dir entry

  [[ -d "${root}/collections" ]] ||
    die "Skill collections do not exist: ${root}/collections"

  for skills_dir in "${root}"/collections/*/skills; do
    [[ -d "${skills_dir}" ]] || continue

    for entry in "${skills_dir}"/*/; do
      [[ -d "${entry}" ]] || continue

      if [[ ! -f "${entry}SKILL.md" ]]; then
        log_verbose "skip ${entry%/} (no SKILL.md)"
        continue
      fi

      add_skill "${entry%/}"
    done
  done
}

# Type "tree": every directory up to three levels below the root that contains
# a SKILL.md. Hidden directories are skipped. If a directory with a SKILL.md
# has a descendant with a SKILL.md, only the deepest one is a skill.
collect_tree() {
  local root="$1"
  local dir other is_deepest
  local -a dirs=()

  [[ -d "${root}" ]] || die "Skill tree does not exist: ${root}"

  while IFS= read -r -d '' dir; do
    dirs+=("${dir}")
  done < <(
    find "${root}" -mindepth 1 -maxdepth 4 \
      \( -type d -name '.*' -prune \) -o \
      \( -type f -name SKILL.md -printf '%h\0' \)
  )

  for dir in "${dirs[@]}"; do
    [[ "${dir}" == "${root}" ]] && continue

    is_deepest=true
    for other in "${dirs[@]}"; do
      if [[ "${other}" == "${dir}/"* ]]; then
        is_deepest=false
        break
      fi
    done

    if [[ "${is_deepest}" == true ]]; then
      add_skill "${dir}"
    else
      log_verbose "skip ${dir} (contains deeper skills)"
    fi
  done
}

# Run the matching collector for every configured skill source.
collect_skills() {
  local source type root

  for source in "${SKILL_SOURCES[@]}"; do
    type="${source%%:*}"
    root="${source#*:}"

    printf 'Collecting skills from %s (%s)...\n' "${root}" "${type}"

    case "${type}" in
      collections) collect_collections "${root}" ;;
      tree) collect_tree "${root}" ;;
      *) die "Unknown skill source type '${type}' in: ${source}" ;;
    esac
  done
}

# Print a skill's absolute path with $HOME collapsed to ${HOME}, so the
# generated config stays portable across machines that share this dotfiles repo.
portable_path() {
  local path="$1"

  printf '%s' "${path/#${HOME}/\$\{HOME\}}"
}

write_dotbot_config() {
  local root name trusted trusted_pattern

  mkdir -p "${DOTBOT_CACHE_DIR}"

  trusted_pattern=""
  for trusted in "${TRUSTED_ROOTS[@]}"; do
    trusted_pattern+="\"$(portable_path "${trusted}")\"/*|"
  done
  trusted_pattern="${trusted_pattern%|}"

  {
    printf -- '---\n'
    printf '################################################################################\n'
    printf '# Setup configuration for Dotbot\n'
    printf '#\n'
    printf '# @see https://github.com/anishathalye/dotbot for more info\n'
    printf '################################################################################\n'
    printf '# AI skill symlinks: every skill directory found in SKILL_SOURCES (see\n'
    printf '# bashrc/helpers/skillz), linked into every agent skill root.\n'
    printf '#\n'
    printf '# This file is generated by `skillz`. Do not edit it by hand; edit\n'
    printf '# bashrc/helpers/skillz and re-run `skillz` instead.\n'
    printf '\n'
    printf -- '- defaults:\n'
    printf '    link:\n'
    printf '      create: true\n'
    printf '      relink: true\n'
    printf '      force: true\n'
    printf '\n'
    printf -- '- shell:\n'
    printf '    -\n'
    printf '      description: Ensure agent skill roots are real directories and remove managed skill symlinks (only those that resolve into a known skill location) before relinking\n'
    printf '      command: |\n'
    printf '        set -e\n'
    printf '        shopt -s nullglob\n'
    printf '\n'
    printf '        is_trusted() {\n'
    printf '          case "$1" in\n'
    printf '            %s) return 0 ;;\n' "${trusted_pattern}"
    printf '            *) return 1 ;;\n'
    printf '          esac\n'
    printf '        }\n'
    printf '\n'
    printf '        for dir in %s; do\n' "${AGENT_SKILL_ROOTS[*]}"
    printf '          expanded="${dir/#\\~/$HOME}"\n'
    printf '\n'
    printf '          if [ -L "${expanded}" ]; then\n'
    printf '            resolved="$(readlink -f "${expanded}" 2>/dev/null || true)"\n'
    printf '            if is_trusted "${resolved}"; then\n'
    printf '              rm "${expanded}"\n'
    printf '            else\n'
    printf '              echo "skillz: refusing to touch ${expanded} -> ${resolved} (outside known skill repositories)" >&2\n'
    printf '              exit 1\n'
    printf '            fi\n'
    printf '          fi\n'
    printf '\n'
    printf '          mkdir -p "${expanded}"\n'
    printf '\n'
    printf '          for entry in "${expanded}"/*; do\n'
    printf '            [ -L "${entry}" ] || continue\n'
    printf '            resolved="$(readlink -f "${entry}" 2>/dev/null || true)"\n'
    printf '            is_trusted "${resolved}" && rm "${entry}"\n'
    printf '          done\n'
    printf '        done\n'
    printf '\n'
    printf -- '- link:\n'
    for name in $(printf '%s\n' "${!SKILL_PATHS[@]}" | sort); do
      for root in "${AGENT_SKILL_ROOTS[@]}"; do
        printf '    %s/%s:\n' "${root}" "${name}"
        printf '      path: %s\n' "$(portable_path "${SKILL_PATHS[${name}]}")"
      done
    done
  } >"${DOTBOT_CONFIG}"
}

show_symlinks() {
  local directory

  printf '\nInstalled symlinks:\n\n'

  for directory in \
    "${HOME}/.agents/skills" \
    "${HOME}/.codex/skills" \
    "${HOME}/.claude/skills"; do
    [[ -d "${directory}" ]] || continue

    printf '%s\n' "${directory}"

    find "${directory}" \
      -mindepth 1 \
      -maxdepth 1 \
      -type l \
      -printf '  %f -> %l\n' \
      2>/dev/null || true
  done
}

main() {
  while (($# > 0)); do
    case "$1" in
      --help)
        usage
        exit 0
        ;;
      --verbose) VERBOSE=true ;;
      *)
        usage >&2
        die "Unknown option: $1"
        ;;
    esac
    shift
  done

  command -v dotfiles >/dev/null 2>&1 || die "dotfiles is not available in PATH."

  collect_skills

  ((${#SKILL_PATHS[@]} > 0)) || die "No skills found in any configured skill source."

  printf 'Found %d skill(s).\n' "${#SKILL_PATHS[@]}"
  printf 'Regenerating %s...\n' "${DOTBOT_CONFIG}"
  write_dotbot_config

  printf '\nRunning: dotfiles %s\n\n' "${DOTBOT_CONFIG}"
  dotfiles "${DOTBOT_CONFIG}"

  show_symlinks

  printf '\nDone.\n'
}

main "$@"
