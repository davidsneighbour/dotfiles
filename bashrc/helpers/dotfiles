#!/bin/bash
################################################################################
# dotfiles — dotbot wrapper script
#
# Runs configs/dotbot/config[.NAME].yaml via the brew-installed dotbot binary.
# Optional extra configs are read from configs/dotbot/includes.yaml.
#
# Usage:
#   dotfiles [CONFIG_NAME]
#   dotfiles --config CONFIG_NAME
#   dotfiles --list
#   dotfiles --help
#
# @see https://github.com/davidsneighbour/dotfiles
# @see https://github.com/anishathalye/dotbot
################################################################################

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "${SCRIPT_PATH}")/../.." && pwd)"
CONFIGS_DIR="${REPO_ROOT}/configs/dotbot"
DEFAULT_CONFIG_FILE="config.yaml"
INCLUDES_FILE="${CONFIGS_DIR}/includes.yaml"

__LOGFILE="${HOME}/.logs/dotbot/dotfiles-$(date +%Y%m%d-%H%M%S).log"

source_core_libs() {
  local base_path="${BASHRC_PATH:-${REPO_ROOT}/bashrc}"
  local core_dir="${base_path}/lib/00-core"
  local file=''

  for file in "${core_dir}"/*.bash; do
    [[ -f "${file}" && -r "${file}" ]] || continue
    # shellcheck disable=SC1090
    source "${file}"
  done
}

print_help() {
  cat <<'HELP'
Usage:
  dotfiles [CONFIG_NAME]
  dotfiles --config CONFIG_NAME
  dotfiles --list
  dotfiles --help

Options:
  --config CONFIG_NAME   Run a specific config.
                         Supported forms are equivalent:
                           host-locutus
                           config.host-locutus.yaml
  --list                 Select and run a config from configs/dotbot via gum.
  -h, --help             Show this help.

Behavior:
  - Default (no args): runs configs/dotbot/config.yaml
  - Positional CONFIG_NAME is preferred over --config.
  - Extra configs are loaded from configs/dotbot/includes.yaml when configured.

Prerequisites:
  brew install dotbot
HELP
}

ensure_dotbot_ready() {
  if ! command -v dotbot >/dev/null 2>&1; then
    dnb_log error "dotbot not found. Install it with: brew install dotbot"
    exit 1
  fi
}

normalize_config_to_filename() {
  local raw_config_name="${1}"

  if [[ "${raw_config_name}" == "${DEFAULT_CONFIG_FILE}" || "${raw_config_name}" == config.*.yaml ]]; then
    printf '%s\n' "${raw_config_name}"
    return 0
  fi

  printf 'config.%s.yaml\n' "${raw_config_name}"
}

resolve_config_path() {
  local raw_config_name="${1}"
  local filename

  if [[ -z "${raw_config_name}" ]]; then
    filename="${DEFAULT_CONFIG_FILE}"
  else
    filename="$(normalize_config_to_filename "${raw_config_name}")"
  fi

  printf '%s/%s\n' "${CONFIGS_DIR}" "${filename}"
}

trim_string() {
  local value="${1}"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf '%s\n' "${value}"
}

strip_wrapping_quotes() {
  local value="${1}"

  case "${value}" in
    \"*\")
      value="${value#\"}"
      value="${value%\"}"
      ;;
    \'*\')
      value="${value#\'}"
      value="${value%\'}"
      ;;
    *) ;;
  esac

  printf '%s\n' "${value}"
}

normalize_include_key() {
  local raw_config_name="${1}"

  normalize_config_to_filename "${raw_config_name}"
}

expand_include_config_path() {
  local raw_path="${1}"
  local expanded_path
  local literal_braced_home="\${HOME}"
  local literal_home="\$HOME"
  local literal_tilde='~'

  expanded_path="$(strip_wrapping_quotes "$(trim_string "${raw_path}")")"

  case "${expanded_path}" in
    "${literal_tilde}")
      expanded_path="${HOME}"
      ;;
    "${literal_tilde}/"*)
      expanded_path="${HOME}/${expanded_path#"~/"}"
      ;;
    "${literal_home}")
      expanded_path="${HOME}"
      ;;
    "${literal_home}/"*)
      expanded_path="${HOME}/${expanded_path#"${literal_home}/"}"
      ;;
    "${literal_braced_home}")
      expanded_path="${HOME}"
      ;;
    "${literal_braced_home}/"*)
      expanded_path="${HOME}/${expanded_path#"${literal_braced_home}/"}"
      ;;
    /*) ;;
    *)
      expanded_path="${CONFIGS_DIR}/${expanded_path}"
      ;;
  esac

  printf '%s\n' "${expanded_path}"
}

resolve_included_config_paths() {
  local config_path="${1}"
  local -n included_paths_ref="${2}"
  local config_filename
  local config_short_name
  local current_key=''
  local line=''
  local line_number=0
  local trimmed_line=''
  local include_value=''
  local include_path=''

  if [[ ! -f "${INCLUDES_FILE}" ]]; then
    return 0
  fi

  config_filename="$(basename "${config_path}")"
  config_short_name="${config_filename#config.}"
  config_short_name="${config_short_name%.yaml}"

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$((line_number + 1))
    trimmed_line="$(trim_string "${line}")"

    case "${trimmed_line}" in
      '' | '#'* | '---' | '...')
        continue
        ;;
      -\ *)
        if [[ -z "${current_key}" ]]; then
          dnb_log error "Include entry without parent config in ${INCLUDES_FILE}:${line_number}"
          return 1
        fi

        if [[ "${current_key}" != "${config_filename}" ]]; then
          continue
        fi

        include_value="${trimmed_line#- }"
        include_value="$(trim_string "${include_value}")"

        if [[ -z "${include_value}" ]]; then
          dnb_log error "Empty include path in ${INCLUDES_FILE}:${line_number}"
          return 1
        fi

        include_path="$(expand_include_config_path "${include_value}")"

        if [[ ! -f "${include_path}" ]]; then
          dnb_log error "Included config file not found: ${include_path}"
          return 1
        fi

        included_paths_ref+=("${include_path}")
        ;;
      *:)
        current_key="${trimmed_line%:}"
        current_key="$(strip_wrapping_quotes "$(trim_string "${current_key}")")"

        if [[ -z "${current_key}" ]]; then
          dnb_log error "Empty include config key in ${INCLUDES_FILE}:${line_number}"
          return 1
        fi

        case "${current_key}" in
          "${config_filename}" | "${config_short_name}")
            current_key="${config_filename}"
            ;;
          *)
            current_key="$(normalize_include_key "${current_key}")"
            ;;
        esac
        ;;
      *)
        dnb_log error "Unsupported include syntax in ${INCLUDES_FILE}:${line_number}: ${trimmed_line}"
        return 1
        ;;
    esac
  done <"${INCLUDES_FILE}"
}

run_dotbot_with_config() {
  local config_path="${1}"
  local dotbot_verbosity_flag=''
  local config_paths=()

  if [[ ! -f "${config_path}" ]]; then
    dnb_log error "Config file not found: ${config_path}"
    print_help
    exit 1
  fi

  ensure_dotbot_ready

  export HOSTNAME
  HOSTNAME="$(hostname)"

  config_paths=("${config_path}")
  if ! resolve_included_config_paths "${config_path}" config_paths; then
    exit 1
  fi

  dnb_log info "Running dotbot with config: ${config_paths[*]}"

  if [[ -n "${DNB_VERBOSE:-}" ]]; then
    dotbot_verbosity_flag='-vv'
  else
    dotbot_verbosity_flag='--quiet'
  fi

  cd "${REPO_ROOT}"
  dotbot \
    --base-directory "${REPO_ROOT}" \
    --config-file "${config_paths[@]}" \
    --force-color \
    "${dotbot_verbosity_flag}" \
    --exit-on-failure
}

pick_config_with_gum() {
  if ! command -v gum >/dev/null 2>&1; then
    dnb_log error "--list requires 'gum' (https://github.com/charmbracelet/gum)."
    exit 1
  fi

  local config_files=()
  local file

  shopt -s nullglob
  for file in "${CONFIGS_DIR}"/config.*.yaml; do
    config_files+=("$(basename "${file}")")
  done
  shopt -u nullglob

  if [[ "${#config_files[@]}" -eq 0 ]]; then
    dnb_log error "No selectable config files found in ${CONFIGS_DIR}."
    exit 1
  fi

  mapfile -t config_files < <(printf '%s\n' "${config_files[@]}" | sort)

  local config_names=()
  local config_file
  for config_file in "${config_files[@]}"; do
    config_names+=("${config_file#config.}")
    config_names[${#config_names[@]} - 1]="${config_names[${#config_names[@]} - 1]%.yaml}"
  done

  gum choose --header "Select dotbot config to run" "${config_names[@]}"
}

main() {
  source_core_libs

  local list_mode=0
  local config_arg=''
  local positional_config=''

  while (($#)); do
    case "$1" in
      --config)
        config_arg="${2-}"
        if [[ -z "${config_arg}" ]]; then
          dnb_log error "--config requires a value."
          print_help
          exit 2
        fi
        shift 2
        ;;
      --list)
        list_mode=1
        shift
        ;;
      -h | --help)
        print_help
        exit 0
        ;;
      --*)
        dnb_log error "Unknown option '$1'."
        print_help
        exit 2
        ;;
      *)
        if [[ -n "${positional_config}" ]]; then
          dnb_log error "Only one config name is supported."
          print_help
          exit 2
        fi
        positional_config="$1"
        shift
        ;;
    esac
  done

  local target_config_path=''

  if [[ "${list_mode}" -eq 1 ]]; then
    if [[ -n "${config_arg}" || -n "${positional_config}" ]]; then
      dnb_log error "--list cannot be combined with a config argument."
      print_help
      exit 2
    fi

    local selected_config=''
    selected_config="$(pick_config_with_gum)"
    target_config_path="$(resolve_config_path "${selected_config}")"
    run_dotbot_with_config "${target_config_path}"
    exit 0
  fi

  if [[ -n "${positional_config}" ]]; then
    target_config_path="$(resolve_config_path "${positional_config}")"
  elif [[ -n "${config_arg}" ]]; then
    target_config_path="$(resolve_config_path "${config_arg}")"
  else
    target_config_path="$(resolve_config_path '')"
  fi

  run_dotbot_with_config "${target_config_path}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
