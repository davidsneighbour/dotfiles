# shellcheck shell=bash
# Bashrc partial (sourced by ~/.bashrc)

# set color prompt variables
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export TERM=xterm-color
export GREP_OPTIONS='--color=auto' GREP_COLOR='1;32'
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad
# semantic colour tokens of the active terminal theme (DNB_UI_ACCENT, …)
# replace the former COLOR_* escape variables; see docs/terminal-ui.md
if declare -F dnb_ui_export_tokens >/dev/null; then
  dnb_ui_export_tokens
fi

# set default editor
export VISUAL=/usr/bin/vim.basic
export EDITOR=/usr/bin/vim.basic

# homebrew settings
export HOMEBREW_NO_ENV_HINTS=1
# @see https://docs.brew.sh/Analytics
export HOMEBREW_NO_ANALYTICS=1

# dotfiles setup system
# shellcheck disable=SC2154
export DOTFILES_SETUPDIR="${DOTFILES_PATH}/setup"
if command -v gum >/dev/null 2>&1; then
	DOTFILES_GUM=true
else
	DOTFILES_GUM=false
fi
export DOTFILES_GUM

# shell actor identity: default to human unless LLM mode is explicitly enabled.
# LLM tooling should export LLM=true before sourcing bashrc.
if [ "${LLM}" = "true" ]; then
	export LLM=true
	export HUMAN=false
elif [ "${HUMAN}" = "false" ]; then
	export HUMAN=false
	export LLM=true
else
	export HUMAN=true
	export LLM=false
fi

# set vale styles path
VALE_STYLES_PATH="${HOME}/.config/vale/styles"
export VALE_STYLES_PATH

# reused over several tools, disable telemetry
DISABLE_TELEMETRY=1
export DISABLE_TELEMETRY
